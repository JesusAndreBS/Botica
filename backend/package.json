    "@fastify/socket.io": "^5.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.0",
    "fastify-type-provider-zod": "^1.2.0",
    "ioredis": "^5.3.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "socket.io": "^4.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
