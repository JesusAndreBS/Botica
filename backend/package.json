{
  "name": "nova-salud-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "worker:stock": "tsx watch src/workers/stock-alerts.ts",
    "prisma:generate": "prisma generate",
