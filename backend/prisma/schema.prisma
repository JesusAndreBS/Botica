generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN FARMACÉUTICO VENDEDOR CAJERO }
enum ProductStatus { ACTIVO INACTIVO DESCONTINUADO RESTRINGIDO }
enum SaleStatus { PENDIENTE COMPLETADA CANCELADA DEVUELTA }
enum PaymentMethod { EFECTIVO TARJETA_DEBITO TARJETA_CREDITO TRANSFERENCIA MIXTO YAPE_PLIN }
enum AlertType { BAJO_STOCK STOCK_CRITICO PROXIMO_VENCER VENCIDO SIN_MOVIMIENTO }
enum AlertSeverity { INFO WARNING CRITICAL }

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          UserRole  @default(VENDEDOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sales         Sale[]    @relation("SaleCashier")
  alerts        Alert[]   @relation("AlertAssigned")
  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([parentId])
  @@map("categories")
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  ruc         String?   @unique
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  @@index([ruc])
  @@index([isActive])
  @@map("suppliers")
}

model Product {
  id              String        @id @default(cuid())
  code            String        @unique @db.VarChar(50)
  barcode         String?       @unique @db.VarChar(100)
  name            String        @db.VarChar(200)
  description     String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  purchasePrice   Decimal       @db.Decimal(12, 4)
  salePrice       Decimal       @db.Decimal(12, 4)
  wholesalePrice  Decimal?      @db.Decimal(12, 4)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  stock           Int           @default(0)
  minStock        Int           @default(10)
  maxStock        Int?
  batchTracked    Boolean       @default(true)
  requiresRecipe  Boolean       @default(false)
  status          ProductStatus @default(ACTIVO)
  imageUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  batches         Batch[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
  alerts          Alert[]
  @@index([code])
  @@index([barcode])
  @@index([categoryId, status])
  @@index([supplierId])
  @@index([status, stock])
  @@map("products")
}

model Batch {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber     String    @db.VarChar(50)
  quantity        Int
  remainingQty    Int
  expiryDate      DateTime
  manufactureDate DateTime?
  purchasePrice   Decimal   @db.Decimal(12, 4)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  stockMovements  StockMovement[]
  @@unique([productId, batchNumber])
  @@index([expiryDate])
  @@index([productId, expiryDate])
  @@map("batches")
}

model Sale {
  id              String       @id @default(cuid())
  saleNumber      String       @unique @db.VarChar(20)
  customerName    String?
  customerDni     String?      @db.VarChar(15)
  customerPhone   String?
  subtotal        Decimal      @db.Decimal(12, 4)
  taxAmount       Decimal      @db.Decimal(12, 4)
  discountAmount  Decimal      @default(0) @db.Decimal(12, 4)
  total           Decimal      @db.Decimal(12, 4)
  paymentMethod   PaymentMethod
  paymentDetails  Json?
  status          SaleStatus   @default(COMPLETADA)
  cashierId       String
  cashier         User         @relation("SaleCashier", fields: [cashierId], references: [id])
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           SaleItem[]
  @@index([saleNumber])
  @@index([cashierId, createdAt])
  @@index([status, createdAt])
  @@index([customerDni])
  @@map("sales")
}

model SaleItem {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  quantity      Int
  unitPrice     Decimal   @db.Decimal(12, 4)
  discount      Decimal   @default(0) @db.Decimal(12, 4)
  taxRate       Decimal   @db.Decimal(5, 2)
  lineTotal     Decimal   @db.Decimal(12, 4)
  createdAt     DateTime  @default(now())
  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_items")
}

model StockMovement {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId         String?
  batch           Batch?   @relation(fields: [batchId], references: [id])
  type            String
  quantity        Int
  referenceId     String?
  referenceType   String?
  reason          String?
  userId          String?
  createdAt       DateTime @default(now())
  @@index([productId, createdAt])
  @@index([batchId])
  @@index([referenceId, referenceType])
  @@map("stock_movements")
}

model Alert {
  id            String       @id @default(cuid())
  type          AlertType
  severity      AlertSeverity
  title         String
  message       String
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id])
  assignedToId  String?
  assignedTo    User?        @relation("AlertAssigned", fields: [assignedToId], references: [id])
  isRead        Boolean      @default(false)
  isResolved    Boolean      @default(false)
  resolvedAt    DateTime?
  resolvedById  String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([type, severity, isResolved])
  @@index([productId, isResolved])
  @@index([assignedToId, isRead])
  @@index([createdAt])
  @@map("alerts")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String
  description String?
  updatedAt   DateTime @updatedAt
  @@index([category])
  @@map("settings")
}